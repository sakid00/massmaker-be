# Server
PORT=8080
APP_ENV=development

# Postgres (local compose). Prod compose overrides DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5480/massmaker?sslmode=disable
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Human JWT — copy the same values from enmasse-be.
JWT_ACCESS_SECRET=dev-enmasse-access-secret-change-me-32b
JWT_ISSUER=https://api.enmasse.id

# Service JWT — Massmaker mints, Enmasse verifies.
JWT_SERVICE_SECRET=dev-enmasse-service-secret-change-me-32
ENMASSE_INTERNAL_URL=http://127.0.0.1:8081

# Staff admin (own table, not Enmasse artists). Example hash is "change-me".
# Generate: printf '%s' 'your-secret' | go run ./cmd/hashpw
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD='$2a$10$KRp6JKCHEX59qiJ/1IaVN.DwORIvHOZV1n5uCJpZujOCgEc1WGLhi'
STAFF_JWT_SECRET=dev-massmaker-staff-secret-change-me32
STAFF_JWT_EXPIRY=8h

CORS_ORIGINS=http://localhost:3000,https://massmaker.id

# Cloudflare R2 (S3-compatible). Leave empty locally to get 503 on POST /v1/me/media/presign.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# HMAC pepper for consent IP/UA hashes. Never store raw IP or user-agent.
CONSENT_HASH_PEPPER=dev-massmaker-consent-pepper-change
LEGAL_DOCUMENT_VERSION=1.0

# Caddy (docker-compose.prod.yml only)
ACME_EMAIL=admin@example.com
MASSMAKER_DOMAIN=massmaker.id
