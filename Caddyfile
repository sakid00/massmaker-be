# One Caddy on VPS2. Apex is the Next app (massmaker-fe service "fe").
# API stays on the api subdomain. Swagger stays off the public host.

{
	email {$ACME_EMAIL}
}

{$MASSMAKER_DOMAIN} {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	@notLocalhost not host localhost 127.0.0.1
	header @notLocalhost Strict-Transport-Security "max-age=31536000; includeSubDomains"

	reverse_proxy fe:3000
}

api.{$MASSMAKER_DOMAIN} {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	@notLocalhost not host localhost 127.0.0.1
	header @notLocalhost Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@private path /swagger /swagger/*
	handle @private {
		respond 404
	}
	handle {
		reverse_proxy api:8080
	}
}
